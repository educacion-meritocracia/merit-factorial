@fig-likerplot1 displays the response distributions by wave, distinguishing perceptions from preferences. The pattern is stable across waves. Among perceptions, agreement is high for contacts, parental wealth, and talent, and lowest for effort. Among preferences, by contrast, effort is overwhelmingly endorsed as the legitimate basis for rewards, far exceeding its perceived role in practice, whereas talent is the least endorsed criterion, below contacts and family resources. More than half of respondents in both waves accept the influence of rich parents and contacts, so privilege criteria are not uniformly seen as an illegitimate way to get ahead.


```{r fig-likerplot1, echo=FALSE}
#| fig-align: center
#| fig-cap: "Distribution of responses on the scale of perceptions and preferences regarding meritocracy by wave"
#| fig-cap-location: top
#| fig-asp: 0.6
#| out-width: '100%'
#| warning: false
#| message: false

library(cowplot)

cols  <- RColorBrewer::brewer.pal(4, "RdBu")
items1 <- c("perc_effort","perc_talent","perc_rich_parents","perc_contact")

db_likert1 <- db_long %>%
  filter(ola == 1) %>%
  select(starts_with(c("perc"))) %>%
  tidyr::drop_na() %>%                     # <- igual que tu na.omit() (complete-cases)
  pivot_longer(everything(), names_to="item", values_to="x") %>%
  mutate(
    item = factor(item, levels = rev(items1),
                  labels = c("Contacts","Rich parents","Talent","Effort")),
    cat  = factor(x, 1:4,
                  c("Strongly disagree","Disagree","Agree","Strongly agree"),
                  ordered = TRUE)
  ) %>% 
  na.omit()

db_likert1 <- db_likert1 %>% count(item, cat) %>% group_by(item) %>% mutate(p = n/sum(n)) %>% ungroup() %>%
  mutate(s = ifelse(as.integer(cat) <= 2, -p, p))

lab1 <- db_likert1 %>%
  mutate(side = ifelse(as.integer(cat) <= 2, "Disagree", "Agree")) %>%
  group_by(item, side) %>% summarise(p = sum(p), .groups="drop") %>%
  mutate(x = ifelse(side=="Disagree", -(p+.03), (p+.03)),
         h = ifelse(side=="Disagree", 1, 0),
         lab = scales::percent(p, 0.1))

a <- ggplot(db_likert1, aes(s, item, fill = cat)) +
  geom_col(width = .8) +
  geom_vline(xintercept = 0, linewidth = .35) +
  geom_text(data = lab1, aes(x = x, y = item, label = lab, hjust = h),
            inherit.aes = FALSE, size = 7 / .pt) +
  scale_fill_manual(values = cols) +
  scale_x_continuous(labels = \(z) scales::percent(abs(z)), limits = c(-1.1, 1.1)) +
  coord_cartesian(clip = "off") +
  labs(title = "Perceptions", x = NULL, y = NULL, fill = NULL) +
  theme(plot.title = element_text(size = 9),
        axis.text.x = element_blank(), axis.ticks.x = element_blank()) +
  theme(legend.position = "none", panel.grid.major.y = element_blank(),
        plot.margin = margin(5, 4, 5, 10))

items2 <- c("pref_effort","pref_talent","pref_rich_parents","pref_contact")

db_likert2 <- db_long %>%
  filter(ola == 1) %>%
  select(starts_with(c("pref"))) %>%
