# 4) grilla 2x2
# sin align horizontal: si no, el panel de preferencias hereda el ancho del eje Y y deja un hueco
panels <- cowplot::plot_grid(a, b, c, d, ncol = 2, rel_widths = c(1.25, 1))

# 5) poner Wave 1 / Wave 2 encima (no consume ancho)
panels_labeled <- cowplot::ggdraw(panels) +
  draw_label("Wave 1", x = 0.03, y = 0.75, angle = 0, hjust = 1.5, vjust = 0.5, size = 9) +
  draw_label("Wave 2", x = 0.03, y = 0.25, angle = 0, hjust = 1.5, vjust = 0.5, size = 9)

# 6) leyenda a mano COMO PANEL (sin extraer grobs)
lik_labels <- c("Strongly disagree", "Disagree", "Agree", "Strongly agree")
df_leg <- tibble(cat = factor(lik_labels, levels = lik_labels))

legend_only <- ggplot(df_leg, aes(x = 2, y = 2, fill = cat)) +
  geom_point(shape = 22, size = 6, color = "black", stroke = 0.3) +
  coord_cartesian(xlim = c(0, 1), ylim = c(0, 1), clip = "on") +  # “esconde” los puntos
  scale_fill_manual(values = cols, drop = FALSE) +
  guides(fill = guide_legend(nrow = 1, byrow = TRUE, title = NULL)) +
  theme_void() +
  theme(
    legend.position = "bottom",
    legend.text     = element_text(size = 9),
    legend.key.size = unit(4, "mm"),
    plot.margin     = margin(0, 0, 0, 0)
  )
# 7) caption común como panel
cap <- ggplot() +
  labs(caption = paste("Source: own elaboration based on", if (exists("params") && isTRUE(params$blinded)) "panel survey data [name withheld for review]" else "EDUMER Panel Survey", "(N Wave 1 =  846; N Wave 2 = 662)")) +
  theme_void() +
  theme(plot.caption = element_text(size = 8, hjust = 1, margin = margin(0)),
        plot.caption.position = "plot",
        plot.margin = margin(0, 18, 0, 0))  # same right margin as the preference panels

# 8) final: todo junto
final <- plot_grid(
  panels_labeled,
  legend_only,
  cap,
  ncol = 1,
  rel_heights = c(1.5, 0.10, 0.10)
)

final +
  theme(plot.margin = margin(t = 5.5, r = 5.5, b = 5.5, l = 50))

```


@fig-likerplot2 shows the same items by cohort, which reveals a sharper contrast between perceptions and preferences. Meritocratic perceptions (effort and talent) receive more agreement in the primary than in the secondary cohort, while the reverse holds for privilege perceptions (contacts and family wealth), consistent with a "disillusionment" with meritocracy as students progress through school [@fan_disillusionment_2026; @tang_meritocratic_2025]. Preferences are more stable across cohorts: effort is the most endorsed basis for reward, while talent, family wealth, and especially contacts remain more ambivalent, with contacts more often accepted than rejected in both cohorts. Overall, the cohort comparison reveals a widening gap between an effort-centered meritocratic ideal and the perceived importance of privilege in practice.

